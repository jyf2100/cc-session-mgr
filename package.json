{
  "name": "cc-session-mgr",
  "version": "2026.6.15",
  "description": "CLI tool to analyze Claude Code session data and generate daily/weekly/project reports",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "session-mgr": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "session",
    "report",
    "daily-report",
    "weekly-report",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jyf2100/cc-session-mgr.git"
  },
  "homepage": "https://github.com/jyf2100/cc-session-mgr#readme",
  "bugs": {
    "url": "https://github.com/jyf2100/cc-session-mgr/issues"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ink": "^6.8.0",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
